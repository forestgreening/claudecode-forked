#!/usr/bin/env bash
# post-merge hook - auto install/build when relevant files change after a merge
# Installed at: .git/hooks/post-merge

# Colors
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
RESET='\033[0m'

info()    { echo -e "${CYAN}[post-merge]${RESET} $*"; }
success() { echo -e "${GREEN}[post-merge]${RESET} $*"; }
warn()    { echo -e "${YELLOW}[post-merge]${RESET} $*"; }

# ORIG_HEAD is set by git to the pre-merge commit
PREV="${ORIG_HEAD:-HEAD~1}"
CURR="HEAD"

# Get list of files changed by the merge
changed_files() {
  git diff --name-only "${PREV}" "${CURR}" 2>/dev/null
}

CHANGED="$(changed_files)"

if [[ -z "$CHANGED" ]]; then
  # Nothing changed - silent exit
  exit 0
fi

# ── Check package files ───────────────────────────────────────────────────────
NEED_INSTALL=false
if echo "$CHANGED" | grep -qE '^(package\.json|package-lock\.json)$'; then
  NEED_INSTALL=true
fi

# ── Check source files ────────────────────────────────────────────────────────
NEED_BUILD=false
if echo "$CHANGED" | grep -qE '^(src/|agents/|skills/|scripts/|bridge/)'; then
  NEED_BUILD=true
fi

# Nothing relevant changed - silent exit
if [[ "$NEED_INSTALL" == false && "$NEED_BUILD" == false ]]; then
  exit 0
fi

# ── npm install ───────────────────────────────────────────────────────────────
if [[ "$NEED_INSTALL" == true ]]; then
  info "package.json changed - running npm install..."
  if npm install --silent 2>&1; then
    success "npm install complete."
    # If deps changed, always rebuild
    NEED_BUILD=true
  else
    warn "npm install failed. Run 'npm install' manually."
  fi
fi

# ── npm run build ─────────────────────────────────────────────────────────────
if [[ "$NEED_BUILD" == true ]]; then
  info "Source files changed - running npm run build..."
  if npm run build 2>&1; then
    success "Build complete. Agents and skills are up to date."
  else
    warn "Build failed. Run 'npm run build' manually to fix."
    warn "The merge itself succeeded - your code is intact."
  fi
fi

# ── Verify HUD ─────────────────────────────────────────────────────────────
if [[ "$NEED_BUILD" == true ]]; then
  REPO_ROOT="$(git rev-parse --show-toplevel)"
  if [[ -f "$REPO_ROOT/dist/hud/index.js" ]]; then
    success "HUD statusline OK."
  else
    warn "HUD entry missing (dist/hud/index.js). Run 'npm run build' manually."
  fi
fi

# Always exit 0 so the merge is never blocked
exit 0
